# ─────────────────────────────────────────────────────────────────────────────
# Voice ERP kit — the ONE config file for api, ai and web (Docker or local).
# Copy to .env (`make setup` does it), fill in your keys, restart (`make restart`).
# Everything works with the mock providers: no key needed to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your company's data ──
# Your team zip ships it in ./data (seed/ + context/). Relative paths are resolved from this repo's root.
DATA_DIR=./data

# ── Ports on your machine ──
# ERP UI → http://localhost:5173
WEB_PORT=5173
# ERP REST API (+ /api/events/stream)
API_PORT=4000
# AI service: /chat, /command, WS /voice
AI_PORT=4100
# Where the AI service reaches the ERP (local mode; Docker sets it for you)
ERP_API_URL=http://localhost:4000

# ── LLM ──
# provider: opencode-go | nvidia | anthropic | deepseek | openai | gemini | openai-compatible | mock
#   Supports an ordered comma-separated fallback chain, e.g. `LLM_PROVIDER=opencode-go,nvidia,anthropic`
#   (or `LLM_PROVIDER=opencode-go` + `LLM_FALLBACKS=nvidia,anthropic`). If #1 fails (429/quota/outage) before
#   emitting output, the AI service seamlessly fails over to #2, then #3.
#   opencode-go       preset OpenCode Go v2 (https://opencode.ai/inference/go/openai/v1, default deepseek-v4.1-flash, key OPENCODE_API_KEY)
#   nvidia            preset NVIDIA NIM (default nvidia/nemotron-3-ultra-550b-a55b, key NVIDIA_API_KEY or LLM_API_KEY)
#   deepseek          preset DeepSeek API (default deepseek-chat; override LLM_MODEL=deepseek-flash if needed)
#   openai-compatible any OpenAI-style endpoint (Groq, Together, vLLM, Ollama…): set LLM_BASE_URL + LLM_MODEL
LLM_PROVIDER=mock
LLM_FALLBACKS=
# Anthropic models: claude-sonnet-5-5 (default, balanced) · claude-haiku-5-5 (fastest, cheapest) · claude-opus-5-5 (smartest, slower)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Dedicated per-provider keys (recommended when using an ordered fallback chain like opencode-go,nvidia,anthropic)
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
# Effort / thinking: Anthropic (low|medium|high) · NVIDIA Nemotron (none|low = thinking off, medium|high = thinking on); ignored elsewhere
LLM_EFFORT=low
# max model ↔ tool round-trips per turn
AGENT_MAX_STEPS=8

# ── Jev (TypeSafe AI decision model) — optional, used NEXT to the LLM, not instead of it ──
# Not a chat model: it answers typed questions (choice / score / yes-no) with probabilities, fast.
# For routing, "which product did the caller mean", yes/no confirmation… See apps/ai/README.md "Jev".
# Empty key → get_jev_client() returns None and nothing changes.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── Speech-to-text ── provider: deepgram | soniox | gradium | openai | nvidia | mock
#   deepgram  model nova-3 (default; French via STT_LANGUAGE=fr)        https://console.deepgram.com
#   soniox    model stt-rt-v6 (default; real-time WebSocket, webm OK)   https://console.soniox.com
#   gradium   model default (browser webm is re-wrapped to ogg; Safari mp4 not accepted)  https://gradium.ai
#   openai    model gpt-4o-mini-transcribe
#   nvidia    OPTIONAL (Riva gRPC on NVCF): model parakeet (default, live + vocabulary boost) | whisper (offline only)
#             key NVIDIA_API_KEY (STT_API_KEY also accepted); needs `uv sync --extra nvidia` + ffmpeg, see README "NVIDIA STT"
# The browser records audio/webm;codecs=opus: deepgram, soniox, gradium, openai accept it; nvidia decodes it with ffmpeg.
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=fr
# NVIDIA only (all optional; leave empty for the defaults)
NVIDIA_API_KEY=
NVIDIA_STT_FUNCTION_ID=
NVIDIA_STT_URI=
NVIDIA_STT_BOOST=
NVIDIA_STT_STREAMING=auto
# Docker only: install the optional NVIDIA bits in the ai image (empty = stock image), then `make rebuild`
AI_UV_SYNC_ARGS=
AI_APT_PACKAGES=

# ── Text-to-speech ── provider: elevenlabs | gradium | openai | mock (mock = the browser speaks)
#   elevenlabs  model eleven_flash_v2_5 (default, ~100 ms; eleven_v4_turbo = more expressive)
#               voice JBFqnCBsd6RMkjVDRZzb (default, multilingual) — pick a French voice in your ElevenLabs library
#   gradium     model default; voice F7Iib4MAyHIRed0x (default: Armand, fr-FR, masculine)
#               other fr-FR voices: 0fvH6XAKvA748v2v (Tiphaine), vMYQUSzm6GRkJX6d (Olivier), J4XbCGPYNMigXcfZ (Amélie)
#   openai      model gpt-4o-mini-tts, voice alloy
# Every provider streams mp3 to the browser (Gradium's PCM is encoded to mp3 on the fly).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_LANGUAGE=fr

# ── Session memory & latency (all optional, defaults shown; see apps/ai/README.md and DECISIONS.md §6) ──
# AI_STATE_DIR=.state          # SQLite session memory (Docker: /state, volume ai-state)
# SESSION_TTL_HOURS=12
# SESSION_MAX=200
# COMPACT_KEEP_TURNS=6
# COMPACT_TRIGGER_TURNS=12
# COMPACT_MAX_CHARS=48000
# COMPACT_LLM=0                # 1 = LLM-refined summary (background, +1 call per compaction)
# VOICE_EARLY_FILLER=1         # 0 = filler only at the first tool call
# VOICE_TOOL_START=1
